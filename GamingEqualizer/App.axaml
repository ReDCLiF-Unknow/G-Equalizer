<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GamingEqualizer.App"
             RequestedThemeVariant="Dark">

    <!-- ControlThemes must be in Application.Resources, not Styles -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- â”€â”€ Accent palette â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
                 Defined here (not in Style.Resources) so ThemeColors.Apply can
                 replace them at runtime â€” style resources would shadow these and
                 the UI would never repaint. All accent use is DynamicResource;
                 the values below are only the defaults before settings load. -->
            <SolidColorBrush x:Key="AccentBrush"       Color="#7c3aed"/>
            <SolidColorBrush x:Key="AccentPinkBrush"   Color="#f472b6"/>
            <SolidColorBrush x:Key="AccentTextBrush"   Color="#a78bfa"/>
            <SolidColorBrush x:Key="AccentSoftBrush"   Color="#c4b5fd"/>
            <SolidColorBrush x:Key="AccentDeepBrush"   Color="#5b21b6"/>
            <SolidColorBrush x:Key="AccentChipBgBrush" Color="#2d1060"/>
            <SolidColorBrush x:Key="AccentBrush55"     Color="#557c3aed"/>
            <SolidColorBrush x:Key="AccentBrush99"     Color="#997c3aed"/>
            <SolidColorBrush x:Key="AccentBrush1A"     Color="#1a7c3aed"/>
            <SolidColorBrush x:Key="AccentBrush2A"     Color="#2a7c3aed"/>

            <!-- â”€â”€ Default Button â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
                <Setter Property="Background"      Value="#0d0d1a"/>
                <Setter Property="Foreground"      Value="#c4c4d0"/>
                <Setter Property="BorderBrush"     Value="#252538"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="12,6"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="BorderBrush" Value="#44447a"/>
                    <Setter Property="Background"  Value="#12122a"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Background" Value="#1a1a35"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.35"/>
                </Style>
            </ControlTheme>

            <!-- Primary button (deep violet) -->
            <ControlTheme x:Key="PrimaryButtonTheme" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource AccentDeepBrush}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground"      Value="#ede9fe"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="12,6"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background"  Value="#6d28d9"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Background" Value="#4c1d95"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.35"/>
                </Style>
            </ControlTheme>

            <!-- Danger button (pink tint) -->
            <ControlTheme x:Key="DangerButtonTheme" TargetType="Button">
                <Setter Property="Background"      Value="#db277710"/>
                <Setter Property="BorderBrush"     Value="#db277766"/>
                <Setter Property="Foreground"      Value="{DynamicResource AccentPinkBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="12,6"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="#db27771a"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPinkBrush}"/>
                </Style>
            </ControlTheme>

            <!-- Icon button (borderless, small) -->
            <ControlTheme x:Key="IconButtonTheme" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground"      Value="#44445a"/>
                <Setter Property="Padding"         Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource AccentPinkBrush}"/>
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Foreground" Value="#db2777"/>
                </Style>
            </ControlTheme>

            <!-- Preset chip (ToggleButton) -->
            <ControlTheme x:Key="ChipTheme" TargetType="ToggleButton">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="#44445a"/>
                <Setter Property="BorderBrush"     Value="#1e1e34"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="14,5"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="Margin"          Value="4,0"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush55}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="#8877cc"/>
                </Style>
                <Style Selector="^:checked /template/ Border#Bd">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background"  Value="{DynamicResource AccentChipBgBrush}"/>
                </Style>
                <Style Selector="^:checked">
                    <Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}"/>
                </Style>
            </ControlTheme>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- â”€â”€ Palette â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style Selector="Window, UserControl">
            <Style.Resources>
                <SolidColorBrush x:Key="BackgroundBrush"    Color="#06060e"/>
                <SolidColorBrush x:Key="AppSurfaceBrush"    Color="#0b0b16"/>
                <SolidColorBrush x:Key="TitlebarBrush"      Color="#07070f"/>
                <SolidColorBrush x:Key="SectionBgBrush"     Color="#08080f"/>
                <SolidColorBrush x:Key="SurfaceBrush"       Color="#0d0d1a"/>
                <SolidColorBrush x:Key="SectionBorderBrush" Color="#181828"/>
                <SolidColorBrush x:Key="TextBrush"          Color="#c4c4d0"/>
                <SolidColorBrush x:Key="TextDimBrush"       Color="#44445a"/>
                <SolidColorBrush x:Key="MutedTextBrush"     Color="#2a2a44"/>
                <SolidColorBrush x:Key="ErrorBrush"         Color="#db2777"/>

                <!-- Perforated speaker-grille tile: staggered dot lattice over SectionBgBrush -->
                <DrawingBrush x:Key="GrilleBgBrush"
                              TileMode="Tile"
                              Stretch="None"
                              SourceRect="0,0,16,16"
                              DestinationRect="0,0,16,16">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#08080f">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,16,16"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#15152b">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Rect="2.6,2.6,2.8,2.8"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#15152b">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Rect="10.6,10.6,2.8,2.8"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Style.Resources>
        </Style>

        <!-- Global palette resources accessible app-wide -->
        <Style Selector=":is(Control)">
            <Style.Resources>
                <SolidColorBrush x:Key="BackgroundBrush"    Color="#06060e"/>
                <SolidColorBrush x:Key="AppSurfaceBrush"    Color="#0b0b16"/>
                <SolidColorBrush x:Key="TitlebarBrush"      Color="#07070f"/>
                <SolidColorBrush x:Key="SectionBgBrush"     Color="#08080f"/>
                <SolidColorBrush x:Key="SurfaceBrush"       Color="#0d0d1a"/>
                <SolidColorBrush x:Key="SectionBorderBrush" Color="#181828"/>
                <SolidColorBrush x:Key="TextBrush"          Color="#c4c4d0"/>
                <SolidColorBrush x:Key="TextDimBrush"       Color="#44445a"/>
                <SolidColorBrush x:Key="MutedTextBrush"     Color="#2a2a44"/>
                <SolidColorBrush x:Key="ErrorBrush"         Color="#db2777"/>

                <!-- Perforated speaker-grille tile: staggered dot lattice over SectionBgBrush -->
                <DrawingBrush x:Key="GrilleBgBrush"
                              TileMode="Tile"
                              Stretch="None"
                              SourceRect="0,0,16,16"
                              DestinationRect="0,0,16,16">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#08080f">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,16,16"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#15152b">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Rect="2.6,2.6,2.8,2.8"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#15152b">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Rect="10.6,10.6,2.8,2.8"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Style.Resources>
        </Style>

        <!-- â”€â”€ ScrollBar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style Selector="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background"   Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPinkBrush}"/>
        </Style>

        <!-- â”€â”€ TextBox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style Selector="TextBox">
            <Setter Property="Background"      Value="#0d0d1a"/>
            <Setter Property="Foreground"      Value="#c4c4d0"/>
            <Setter Property="BorderBrush"     Value="#252538"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="CornerRadius"    Value="4"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush99}"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush55}"/>
        </Style>

        <!-- â”€â”€ CheckBox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#c4c4d0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>

        <!-- â”€â”€ ComboBox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Style Selector="ComboBox">
            <Setter Property="Background"      Value="#0d0d1a"/>
            <Setter Property="Foreground"      Value="#c4c4d0"/>
            <Setter Property="BorderBrush"     Value="#252538"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c4c4d0"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush1A}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush2A}"/>
        </Style>

        <!-- Class-based helpers for code-behind theme switching -->
        <Style Selector="Button.primary">
            <Setter Property="Theme" Value="{StaticResource PrimaryButtonTheme}"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Theme" Value="{StaticResource DangerButtonTheme}"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Theme" Value="{StaticResource IconButtonTheme}"/>
        </Style>

    </Application.Styles>
</Application>
